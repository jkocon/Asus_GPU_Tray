#!/bin/bash
# Run as root by udev (udev/72-asus-gpu-tray-egpu.rules) when an NVIDIA PCI function or the
# asus-armoury attributes appear, and by asus-gpu-switch-live after a switch.
#
# Keeps the XG Mobile GPU out of D3cold. Waking the XG Mobile's RTX 3070 from D3cold failed on a
# GV601RE ("Unable to change power state from D3cold to D0, device inaccessible", Xid 79, the
# root port retraining a "broken device"), and the GPU stayed lost until a reboot. With
# d3cold_allowed = 0 the card can still runtime-suspend to D3hot, and its root port stays powered.
# The dock has its own power supply, so this costs no battery. The built-in dGPU is left alone:
# its functions are created anew on every switch, with the kernel default (D3cold allowed).
set -u

attr=/sys/class/firmware-attributes/asus-armoury/attributes
[[ $(cat "$attr/egpu_enable/current_value" 2>/dev/null) == 1 ]] || exit 0

for d in /sys/bus/pci/devices/*; do
    [[ $(cat "$d/vendor" 2>/dev/null) == 0x10de && -w $d/d3cold_allowed ]] || continue
    [[ $(<"$d/d3cold_allowed") == 0 ]] && continue
    echo 0 > "$d/d3cold_allowed" && logger -t asus-gpu-tray "XG Mobile: D3cold disabled for $(basename "$d")"
done
exit 0
