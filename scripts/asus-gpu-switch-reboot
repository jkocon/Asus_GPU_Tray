#!/bin/bash
# Run as root by asus-gpu-switch@<mode>.service.
# Schedules a mode change for the next boot and reboots immediately.
# The change itself is done by asus-gpu-switch-apply early during boot, before the NVIDIA
# driver loads. Used for the MUX mode and as the fallback when a live switch cannot run.
set -eu

target="${1:-}"
attr=/sys/class/firmware-attributes/asus-armoury/attributes
state=/var/lib/asus-gpu-tray
lock=/run/asus-gpu-tray.lock  # root-only; /run/lock is world-writable on some distros

case "$target" in
    Integrated|Hybrid|AsusEgpu|AsusMuxDgpu) ;;
    *) echo "Unknown mode: '$target'"; exit 2 ;;
esac

if [[ $target == AsusEgpu && $(cat "$attr/egpu_connected/current_value" 2>/dev/null) != 1 ]]; then
    echo "XG Mobile is not connected/locked - aborting"
    exit 3
fi

# After the NVIDIA driver has lost a GPU (an XG Mobile unlocked while in use, Xid 79), it wedges:
# nvidia-modeset waits forever for the dead GPU, and every process that closes the device hangs
# in the kernel. A normal shutdown then never finishes (seen twice on a GV601RE), so reboot the
# emergency way instead: flush and remount the disks read-only, then reset right away.
gpu_lost() {
    local d found=0
    for d in /sys/bus/pci/devices/*; do
        [[ $(cat "$d/vendor" 2>/dev/null) == 0x10de ]] && found=1
    done
    if [[ $found == 0 && $(cat "$attr/egpu_enable/current_value" 2>/dev/null) == 1 ]]; then
        return 0  # XG Mobile mode, but its GPU is gone from the bus
    fi
    journalctl -k -b -q --no-pager \
        --grep '(NVRM|nvidia).*(fallen off the bus|with non-zero usage count|D3cold to D0)' 2>/dev/null | grep -q .
}

exec 9> "$lock"
if ! flock -n 9; then
    # A live switch that ran into a lost GPU hangs in the kernel for good and keeps the lock.
    gpu_lost || { echo "Another GPU switch is already running - aborting"; exit 1; }
    echo "Another GPU switch holds the lock, but a GPU was lost (that switch is hung) - going on"
fi

# MUX is a firmware setting applied only after a reboot, so writing it now is safe. It goes first:
# if it fails, set -e stops the script before anything is scheduled.
if [[ -e $attr/gpu_mux_mode/current_value ]]; then
    mux=$(cat "$attr/gpu_mux_mode/current_value")
    if [[ $target == AsusMuxDgpu && $mux != 0 ]]; then
        # The firmware answers EBUSY while the XG Mobile is active.
        echo 0 2>/dev/null > "$attr/gpu_mux_mode/current_value" ||
            { echo "The firmware refused the MUX mode - switch to the built-in dGPU first"; exit 1; }
    elif [[ $target != AsusMuxDgpu && $mux == 0 ]]; then
        echo 1 > "$attr/gpu_mux_mode/current_value"
    fi
fi

mkdir -p "$state"
echo "$target" > "$state/pending"

# No NVIDIA blacklist any more: asus-gpu-switch-apply lets the driver come up on the current card
# and then switches the way the live switch does (see there).

sync

if gpu_lost; then
    echo "Scheduled mode $target; the NVIDIA driver lost a GPU, so a normal shutdown would hang - emergency reboot"
    sleep 1  # let the message reach the journal
    sync
    echo s > /proc/sysrq-trigger  # sync (writes to the trigger work whatever kernel.sysrq says)
    sleep 2
    echo u > /proc/sysrq-trigger  # remount everything read-only
    sleep 2
    echo b > /proc/sysrq-trigger  # reset now
fi

echo "Scheduled mode $target, rebooting"
systemctl reboot
