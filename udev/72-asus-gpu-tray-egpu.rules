# Asus GPU Tray: keep the XG Mobile GPU out of D3cold (see asus-gpu-egpu-power).
# Both events are needed: at boot the NVIDIA card and asus-armoury can appear in either order.
ACTION=="add|bind", SUBSYSTEM=="pci", ATTR{vendor}=="0x10de", RUN+="/usr/local/lib/asus-gpu-tray/asus-gpu-egpu-power"
ACTION=="add", SUBSYSTEM=="firmware-attributes", KERNEL=="asus-armoury", RUN+="/usr/local/lib/asus-gpu-tray/asus-gpu-egpu-power"
