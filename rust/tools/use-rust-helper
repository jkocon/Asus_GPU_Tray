#!/usr/bin/env bash
# Phase 3 of the Rust rewrite: run one root helper from the Rust binary instead of its shell script,
# on this machine only. The installed script moves to legacy/ and a two-line wrapper takes its
# place, so the units, the udev rule and the scripts that call each other stay unchanged.
#
#   sudo rust/tools/use-rust-helper install           copy target/release/asus-gpu-tray to $LIB/rust/
#   sudo rust/tools/use-rust-helper on <helper>       use the Rust port (egpu-power, switch-reboot, ...)
#   sudo rust/tools/use-rust-helper off <helper>      back to the shell script
#   rust/tools/use-rust-helper status
#
# Re-running install.sh puts every script back (and leaves legacy/ behind).
set -euo pipefail

HERE=$(cd "$(dirname "$0")" && pwd)
LIB=/usr/local/lib/asus-gpu-tray
BIN=$LIB/rust/asus-gpu-tray
HELPERS="egpu-power switch-reboot switch-apply switch-live"

die() { echo "use-rust-helper: $*" >&2; exit 1; }
script_of() { echo "asus-gpu-$1"; }
need_root() { [[ $EUID -eq 0 ]] || die "run as root (sudo -A $0 $*)"; }
check_helper() { [[ " $HELPERS " == *" $1 "* ]] || die "unknown helper '$1' (one of: $HELPERS)"; }
is_wrapper() { grep -q "use-rust-helper" "$1" 2>/dev/null; }

case ${1:-} in
    install)
        need_root install
        # Root runs this binary, so it must not stay writable by the user who built it.
        install -Dm755 -o root -g root "$HERE/../target/release/asus-gpu-tray" "$BIN"
        echo "Installed $BIN ($("$BIN" --version))"
        ;;
    on)
        need_root on "${2:-}"
        check_helper "${2:-}"
        [[ -x $BIN ]] || die "run '$0 install' first"
        s=$(script_of "$2")
        is_wrapper "$LIB/$s" && { echo "$2: already on the Rust port"; exit 0; }
        install -d "$LIB/legacy"
        mv "$LIB/$s" "$LIB/legacy/$s"
        printf '#!/bin/sh\n# Rust port, see rust/tools/use-rust-helper; the shell script is in legacy/.\nexec %s %s "$@"\n' \
            "$BIN" "$2" > "$LIB/$s"
        chmod 755 "$LIB/$s"
        echo "$2: Rust port"
        ;;
    off)
        need_root off "${2:-}"
        check_helper "${2:-}"
        s=$(script_of "$2")
        is_wrapper "$LIB/$s" || { echo "$2: already the shell script"; exit 0; }
        [[ -f $LIB/legacy/$s ]] || die "no $LIB/legacy/$s to restore"
        mv "$LIB/legacy/$s" "$LIB/$s"
        echo "$2: shell script"
        ;;
    status)
        for h in $HELPERS; do
            if is_wrapper "$LIB/$(script_of "$h")"; then echo "$h: Rust"; else echo "$h: shell"; fi
        done
        [[ -x $BIN ]] && echo "binary: $BIN ($("$BIN" --version))" || echo "binary: not installed"
        ;;
    *)
        sed -n '2,11p' "$0" | sed 's/^# \{0,1\}//'
        ;;
esac
